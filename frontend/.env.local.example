# Frontend environment (specs/21 §21.3). Copy to .env.local and fill in.
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle.

# Django command API base (read models come from Firestore directly; mutations via this API).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Firebase web config (from the Firebase console project settings).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-benefitservicing-workbench.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-benefitservicing-workbench
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-benefitservicing-workbench.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Emulator wiring for the local dev loop. When 'true', the client connects to the
# Auth + Firestore emulators instead of the real backend.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080
