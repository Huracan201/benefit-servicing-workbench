# infrastructure/config.env.example — copy to config.env, fill in, then run the provisioning
# scripts (they source ../config.env via lib.sh). config.env is git-ignored (it names your real
# project). specs/21 §21.2–21.3 are the source of truth for these values.

# --- Required: your GCP project ---------------------------------------------------
export PROJECT_ID=""                 # a REAL project id WITH billing enabled (e.g. benefitservicing-demo)
export REGION="us-east4"             # Cloud Run + Tasks + Scheduler co-located (specs/21 §21.2)

# --- Cloud Run service ------------------------------------------------------------
export SERVICE_NAME="bsw-api"
export IMAGE=""                      # blank => REGION-docker.pkg.dev/PROJECT_ID/bsw/bsw-api:latest

# COST KNOB — Change from spec: specs/21 §21.2 pins min-instances 1 (always warm, no cold
# starts, but billed 24/7). For a cost-sensitive demo we default to 0 = scale to zero: $0 when
# idle, ~2s cold start on the first request after idle (fine for a demo). Set to 1 for the
# production, always-warm posture. MAX_INSTANCES caps blast radius so nothing runs away billing.
export MIN_INSTANCES="0"
export MAX_INSTANCES="2"
export CONCURRENCY="80"              # specs/21 §21.2
export CPU="1"
export MEMORY="512Mi"

# --- Service accounts (blank => derived as bsw-api@ / bsw-invoker@ PROJECT_ID) -----
export RUNTIME_SA=""                 # runs the Cloud Run service (specs/21 §21.2 roles)
export INVOKER_SA=""                 # identity OIDC tasks/jobs authenticate AS (run.invoker)

# --- Secrets (Secret Manager — specs/21 §21.3; store the NAME here, never the value) --
export DJANGO_SECRET_KEY_SECRET="bsw-django-secret-key"

# --- Frontend origin (CORS — specs/21 §21.3) --------------------------------------
export CORS_ALLOWED_ORIGINS=""       # your Vercel URL, e.g. https://bsw.vercel.app

# --- Production-guardrail env (config/settings.py refuses to boot without these) ---
# INTERNAL_DEV_SECRET must NOT be the dev default — prod /internal is OIDC-gated, so this just
# disables the dev-secret bypass. Generate once:  openssl rand -base64 32
export INTERNAL_DEV_SECRET=""
# ALLOWED_HOSTS is auto-DERIVED from the deterministic Cloud Run host (service-projectnumber.
# region.run.app) by deploy-api.sh — leave blank unless you need to override it.
export ALLOWED_HOSTS=""
