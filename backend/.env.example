# BenefitServicing Workbench — backend environment (specs/21 §21.3).
# Copy to `.env` for local dev. Values below are the LOCAL/dev defaults.
# CI uses the same values; demo overrides via the environment / Secret Manager.
# The backend reads configuration from the environment only.

# --- Firestore / Firebase emulators -----------------------------------------
# Presence of FIRESTORE_EMULATOR_HOST puts the stack in offline/dev mode.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- GCP project ------------------------------------------------------------
# Any `demo-`-prefixed id is treated as offline by Firebase (no credentials).
GOOGLE_CLOUD_PROJECT=demo-benefitservicing-workbench

# --- Django core ------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*
SYSTEM_TIMEZONE=America/New_York
LOG_LEVEL=INFO

# --- Async task execution (specs/14) ----------------------------------------
# inline = run task handlers synchronously in-process (auto under emulator).
# cloud  = enqueue to Cloud Tasks (demo).
TASK_EXECUTION_MODE=inline
# Cloud-mode only (demo): OIDC audience (Cloud Run URL) + invoker service account.
TASKS_AUDIENCE=
TASKS_INVOKER_SA=
# Shared secret for /internal/* auth under the emulator (X-Internal-Auth header).
INTERNAL_DEV_SECRET=dev-internal-secret

# --- CORS (specs/21 §21.3) --------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
